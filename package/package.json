  "scripts": {
    "test": "node --test tests/core/*.test.js tests/layout/*.test.js tests/modules/*.test.js tests/renderers.test.js tests/server.test.js",
    "bench": "node benchmarks/core.mjs",
    "bench:visual": "node benchmarks/visual/run.mjs",
    "serve": "node scripts/serve.mjs",
    "build:authoring-pipeline": "node examples/authoring-pipeline/build.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "test:effects": "node scripts/common-effects-check.mjs",
    "test:about": "node scripts/about-page-check.mjs",
    "verify:films": "node examples/verify-numbers.mjs",
    "audit:films": "node scripts/audit-films.mjs",
    "audit:3d": "node scripts/audit-3d.mjs",
    "setup:three": "node scripts/prepare-three-peer.mjs",
    "build:characters": "node scripts/build-character-pack.mjs",
    "build:cinematic-assets": "node scripts/build-source-document-pack.mjs && node scripts/build-cinematic-packs.mjs",
    "lookdev:capture": "node scripts/capture-cinematic-lookdev.mjs",
    "export:film": "node scripts/export-film.mjs",
    "docs:inventory": "node scripts/release-inventory.mjs",
    "docs:check": "node scripts/release-inventory.mjs --check && node scripts/check-doc-links.mjs && node scripts/check-runtime-reference.mjs && node scripts/agents/build.mjs --check",
    "check:package": "node scripts/check-package.mjs",
    "types:build": "node scripts/build-types.mjs",
    "test:types": "tsc --noEmit -p tests/types/tsconfig.json",
    "format:check": "prettier --check \"src/**/*.js\"",
    "format": "prettier --write \"src/**/*.js\"",
    "lint": "eslint src",
    "test:browser:matrix": "node scripts/browser-matrix.mjs",
    "test:package-consumer": "node scripts/package-consumer.mjs",
    "test:distribution": "node scripts/distribution-check.mjs",
    "docs:build": "node scripts/docs-site.mjs",
    "fuzz:importers": "node scripts/fuzz-importers.mjs",
    "bench:visual:browser": "node benchmarks/visual/browser.mjs",
    "test:coverage": "node scripts/coverage.mjs",
    "bench:production": "node benchmarks/production.mjs",
    "test:reference": "node --test --test-concurrency=1 tests/reference/*.test.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "docs:public": "node scripts/docs-site.mjs --public",
    "check:release": "node scripts/check-release.mjs",
    "check": "npm run check:architecture && npm run lint && npm run format:check && npm test && npm run test:types && npm run docs:check && npm run check:package && npm run test:package-consumer",
    "prebuild": "npm run check",
    "build": "node scripts/build-release.mjs",
    "agents:build": "node scripts/agents/build.mjs",
    "agents:check": "node scripts/agents/build.mjs --check",
    "test:agents": "node --test --test-concurrency=2 tests/agents/*.test.mjs",
    "agents:eval": "node scripts/agents/eval.mjs",
    "mcp": "node agents/mcp/server.mjs",
    "export:public": "node scripts/export-public.mjs"
  },
